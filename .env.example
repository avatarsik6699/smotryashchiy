# All variables are optional in development. Copy to .env (never commit it).
SMOTRYASHCHIY_ADDR=:8080
SMOTRYASHCHIY_DB_PATH=./data/smotryashchiy.db

# Production contract: fail-closed startup.
# SMOTRYASHCHIY_PRODUCTION=true
# SMOTRYASHCHIY_RELEASE=<exact 40-character lowercase git sha>   (or build with -ldflags -X main.release=)
# SMOTRYASHCHIY_SECURE_COOKIES=true                              (defaults to true in production)
# SMOTRYASHCHIY_TRUSTED_PROXY_CIDRS=172.31.0.2/32                (required in production)
