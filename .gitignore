# Go
/bin/
/dist/
/data/
*.db
*.db-wal
*.db-shm

# Secrets — never commit
.env
*.key
secrets*.json

# Frontend (built UI: see the web/dist rules below)
# Local agent state
.claude/settings.local.json

# Built web UI (only .gitkeep is tracked so `go build` works without node)
web/dist/*
!web/dist/.gitkeep
web/node_modules/

# Release artifacts built by scripts/build-release.sh
release/
